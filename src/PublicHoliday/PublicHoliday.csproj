	<None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Holiday names, one .resx per culture, embedded VERBATIM in this assembly and parsed by
       PublicHoliday.Localization.NameResources.

       Type="Non-Resx" means MSBuild copies the file in rather than compiling it to .resources.
       Two reasons: compiling .resx for the net35 target needs ResGen.exe via the CLR2 task host,
       which the .NET Core build of MSBuild cannot run (so `dotnet build` would fail, and CI
       builds with the CLI); and the normal .resx route would turn each culture file into a
       satellite assembly, loose files that single-file publishing and trimming drop, taking every
       translation with them. WithCulture="false" likewise stops MSBuild reading the culture out
       of the file name.

       The files stay standard .resx, so resx editors and translation tools still work on them. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Names\*.resx" Type="Non-Resx" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net46" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

